# Dùng bởi `npm run dev` (vite --mode emulator) – kết nối Firebase Emulator Suite, project demo.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-giatreoco.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-giatreoco
VITE_FIREBASE_DATABASE_URL=https://demo-giatreoco-default-rtdb.firebaseio.com
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_EMULATOR=true
