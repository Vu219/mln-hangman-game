# Cấu hình Firebase Web App (Project settings > General > Your apps). Trên Vercel: khai báo ở Settings > Environment Variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_APP_ID=
# Đặt true để kết nối Firebase Emulator Suite thay vì production
VITE_USE_EMULATOR=false
# Máy chạy emulator (mặc định: cùng hostname với trang web, tiện khi test bằng điện thoại trong LAN)
# VITE_EMULATOR_HOST=127.0.0.1
